<?xml version="1.0" encoding="utf-8"?>
<!-- Auto brightness for an AOSP guest on a Galaxy bar phone. The Infinity-X
     image (built for the Find X9 Ultra) ships config_automatic_brightness_available
     false and no nits table, so the guest's Adaptive brightness was missing on
     the S24 although the light sensor works (diag sensors: STK33F11 Light).
     A lux -> backlight curve instead: Samsung's composer takes the brightness
     float as the panel's backlight, 1.0 about the 2600-nit peak, so the values
     below are about 10 nits in the dark to 590 in daylight.
     Read at boot: a static overlay in the guest's /oem (guest_prepare.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="oneos.overlay.samsung.autobrightness">
    <application android:hasCode="false"/>
    <overlay android:targetPackage="android"
        android:isStatic="true"
        android:priority="4"/>
</manifest>
